{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil de usuário do sistema (professor ou coordenador)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "ID único do usuário no Firebase Auth" },
        "email": { "type": "string", "format": "email", "description": "E-mail do usuário" },
        "role": { "type": "string", "enum": ["teacher", "coordinator"], "description": "Perfil de acesso" },
        "name": { "type": "string", "description": "Nome completo do usuário" }
      },
      "required": ["uid", "email", "role", "name"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Disciplina cadastrada na instituição",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Nome da disciplina" }
      },
      "required": ["name"]
    },
    "Question": {
      "title": "Question",
      "description": "Questão do banco de questões",
      "type": "object",
      "properties": {
        "subject": { "type": "string", "description": "Nome da disciplina associada" },
        "text": { "type": "string", "description": "Enunciado da questão" },
        "type": { "type": "string", "enum": ["multiple_choice", "true_false", "discursive"], "description": "Tipo da questão" },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"], "description": "Nível de dificuldade" },
        "topic": { "type": "string", "description": "Tópico da questão" },
        "options": { "type": "array", "description": "Alternativas ou afirmações da questão" },
        "correctAnswer": { "type": "string", "description": "Gabarito da questão" }
      },
      "required": ["subject", "text", "type", "difficulty", "correctAnswer"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Prova gerada no sistema",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Título da prova" },
        "subject": { "type": "string", "description": "Disciplina principal da prova" },
        "klass": { "type": "string", "description": "Identificação da turma" },
        "institution": { "type": "string", "description": "Instituição (Linha 1)" },
        "subInstitution": { "type": "string", "description": "Sub-Instituição (Linha 2)" },
        "course": { "type": "string", "description": "Curso ou descrição" },
        "instructions": { "type": "string", "description": "Instruções da capa da prova" },
        "questionsCount": { "type": "number", "description": "Quantidade de questões" },
        "questionIds": { "type": "array", "description": "Lista de IDs das questões selecionadas" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Data de criação" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Data de atualização" }
      },
      "required": ["title", "questionIds", "questionsCount"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Configurações gerais do sistema",
      "type": "object",
      "properties": {
        "passingGrade": { "type": "string", "description": "Média para aprovação" },
        "gradingSystem": { "type": "string", "description": "Sistema de notas" },
        "schoolName": { "type": "string", "description": "Nome padrão da instituição" },
        "printLayout": { "type": "string", "enum": ["standard", "compact", "large"], "description": "Layout de impressão" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Data da última atualização" }
      },
      "required": ["passingGrade", "schoolName", "printLayout"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Perfis dos usuários autenticados"
    },
    "/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/Subject" },
      "description": "Disciplinas da instituição"
    },
    "/questions/{questionId}": {
      "schema": { "$ref": "#/entities/Question" },
      "description": "Banco de questões"
    },
    "/exams/{examId}": {
      "schema": { "$ref": "#/entities/Exam" },
      "description": "Provas salvas e geradas"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Settings" },
      "description": "Configurações globais do sistema"
    }
  }
}
